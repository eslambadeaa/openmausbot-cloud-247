# ==========================================
# OpenMausBot 24/7 Cloud Configuration
# 100% Free - High Intelligence Setup
# ==========================================

# 1. Project & Network Settings
COMPOSE_PROJECT_NAME=openmausbot
OMB_SERVER_NAME=MausBot-Cloud-247
OMB_HTTP_PORT=8080

# If you have a domain or Cloudflare Tunnel (e.g. https://mybot.trycloudflare.com or https://bot.yourdomain.com):
OMB_PUBLIC_URL=
OMB_HTTPS_HOST=

# 2. Free High-Intelligence AI Models (Choose one or combine them!):

# OPTION A: OpenRouter (DeepSeek R1 / V3, Nemotron, Llama 3.3 70B FREE)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTION B: Groq Cloud (Ultra-Fast Llama 3.3 70B FREE)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# OPTION C: Google Gemini 2.0 via OpenAI-Compatible Endpoint (Free & Highly Intelligent)
# Base URL: https://generativelanguage.googleapis.com/v1beta/openai/
# Key from: https://aistudio.google.com/
OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_COMPAT_API_KEY=

# Enable Phone Companion pairing via QR code
OMB_PHONE_RELAY=1
